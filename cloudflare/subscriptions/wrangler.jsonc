{
  "name": "yingcapital-subscriptions",
  "main": "index.mjs",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Subscriptions" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Subscriptions"] }],
}
